  "compiler_validation": "All 30 user candidates compiled individually with solc 0.8.24 before selection; selected audit is recorded in evaluation/candidate_contract_audit.json.",
  "selection": {
    "requested_total": 30,
    "original_development": 14,
    "new_heldout": 16,
    "criteria": [
      "compiles with solc 0.8.24",
      "not exact content in RAG corpus",
      "not an exact duplicate of enase14",
      "avoid same-name and high-overlap variants of existing 14",
      "increase functional and complexity diversity"
    ],
    "excluded_near_duplicates": [
      "AuctionHouse",
      "CrowdfundingCampaign",
      "ERC20Token",
      "Escrow",
      "MultiSigWallet",
      "SplitPayment",
      "TimeLock",
      "voting"
    ],
    "excluded_redundant_domains": [
      "OnChainGovernance",
      "StakingRewards",
      "NFTCollection",
      "RoyaltyToken",
      "WrappedETH",
      "LotteryPool"
    ],
    "note": "Exclusion of redundant-domain candidates is a diversity choice, not evidence that those files are byte-level duplicates."
  },
